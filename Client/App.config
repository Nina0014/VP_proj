<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

	<appSettings>
		<add key="DataSetPath" value="smart_grid_dataset.csv"></add>
		<add key="InvalidRowsCsv" value="logs\invalid_rows.csv"/>
	</appSettings>

	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="SmartGridBinding" transferMode="Streamed" maxReceivedMessageSize="10485760" sendTimeout="00:05:00" receiveTimeout="00:10:00" openTimeout="00:01:00" closeTimeout="00:01:00"></binding>
			</netTcpBinding>
		</bindings>

		<client>
			<endpoint name ="EndPoint" address="net.tcp://localhost:9000/SmartGridService" binding="netTcpBinding" bindingConfiguration="SmartGridBinding" contract="Common.ISmartGridService">
				
			</endpoint>
		</client>

	</system.serviceModel>
	
</configuration>